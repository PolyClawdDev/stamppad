# STAMP runtime. Copy to .env.local. Never put secrets in this file.

# demo | testnet | mainnet
# demo never talks to money-moving endpoints. testnet/mainnet still refuse
# burns, launches, and Zcash publication unless the allow flags below are true.
STAMP_MODE=demo

# Distinct from STAMP_MODE. Live adapters never silently fall back to fixtures.
# A mainnet launch requires this to be true: the curve is sized from raise.raw,
# which is priced per request, and a launch built from the captured fixture is a
# pool Stonk will not adopt.
STAMP_STONK_READ_LIVE=false
# Builds and sends a real Raydium LaunchLab launch through Stonk's platform.
# Costs the creator roughly 0.0114 SOL in rent and fees, plus whatever quote
# asset they spend on their own allocation. The server never signs it; Phantom
# does, in the creator's browser.
STAMP_ALLOW_LIVE_LAUNCH=false
# Burns tokens on Solana mainnet. Irreversible.
STAMP_ALLOW_LIVE_BURNS=false
STAMP_ALLOW_LIVE_ZCASH_PUBLISH=false
# Real ZEC sales. Settlement is not consensus-atomic and no wallet was verified
# to redeem the ZIP-300 P2SH branches. See docs/EVIDENCE.md before enabling.
STAMP_ALLOW_LIVE_STAMP_SALES=false

# A DATABASE_URL is enough to pick Postgres. Leave STAMP_STORE unset on
# Vercel; setting it to memory there is how launches vanish after refresh.
# STAMP_STORE=memory
DATABASE_URL=

# Optional read-only Stonk + Solana endpoints. Defaults are documented in docs/INTEGRATION.md
STONK_API_BASE=https://www.stonkfun.xyz/api/public/v1
# A paid endpoint. Public RPCs rate-limit hard enough to break launch building.
SOLANA_RPC_URL=
# Same host, wss scheme. Used to await burn confirmation without polling.
SOLANA_WS_URL=
SOLANA_NETWORK=solana:demo

# Zcash. Publication key must stay off application servers in any live setup.
# No node to run: NOWNodes, GetBlock and Tatum all serve zebrad JSON-RPC, which
# covers reading blocks and broadcasting a signed transaction.
ZCASH_NETWORK=zcash:demo
ZCASH_RPC_URL=
# Path to a file containing the publisher transparent spending key. Not used in demo.
# Paying publication fees is not custody of users' token principal.
ZCASH_PUBLISHER_KEY_FILE=
ZCASH_PUBLISHER_TADDR=
ZCASH_MIN_CONFIRMATIONS=10

# Application
NEXT_PUBLIC_STAMP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin the token metadata URI is built from. Token-2022 writes that URI onto
# the mint at creation and it can never be changed, so a mainnet launch refuses
# to build unless this (or NEXT_PUBLIC_APP_URL) is a real https origin that will
# still be serving /api/launches/{mint}/metadata later.
STAMP_METADATA_BASE_URL=

# Signs the wallet session cookie. Left empty, a random key is generated per
# process, so restarting the server ends every open session. Set it to keep
# sessions across restarts or to run more than one instance.
STAMP_SESSION_SECRET=
