# STAMP runtime. Copy to .env.local. Never put secrets in this file.

# demo | testnet | mainnet
# demo never talks to money-moving endpoints. testnet/mainnet still refuse
# burns, launches, and Zcash publication unless the allow flags below are true.
STAMP_MODE=demo

# Distinct from STAMP_MODE. Live adapters never silently fall back to fixtures.
STAMP_STONK_READ_LIVE=false
STAMP_ALLOW_LIVE_LAUNCH=false
STAMP_ALLOW_LIVE_BURNS=false
STAMP_ALLOW_LIVE_ZCASH_PUBLISH=false
# Real ZEC sales. Settlement is not consensus-atomic and no wallet was verified
# to redeem the ZIP-300 P2SH branches. See docs/EVIDENCE.md before enabling.
STAMP_ALLOW_LIVE_STAMP_SALES=false

# postgres | memory
# memory is for local UI and tests. postgres is the durable store.
STAMP_STORE=memory
DATABASE_URL=postgres://stamp:stamp@127.0.0.1:5432/stamp

# Optional read-only Stonk + Solana endpoints. Defaults are documented in docs/INTEGRATION.md
STONK_API_BASE=https://www.stonkfun.xyz/api/public/v1
SOLANA_RPC_URL=
SOLANA_NETWORK=solana:demo

# Zcash. Publication key must stay off application servers in any live setup.
ZCASH_NETWORK=zcash:demo
ZCASH_RPC_URL=
# Path to a file containing the publisher transparent spending key. Not used in demo.
# Paying publication fees is not custody of users' token principal.
ZCASH_PUBLISHER_KEY_FILE=
ZCASH_PUBLISHER_TADDR=
ZCASH_MIN_CONFIRMATIONS=10

# Application
NEXT_PUBLIC_STAMP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
